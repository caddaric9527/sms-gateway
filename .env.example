# ===== 串口 =====
# auto = 自动发现（推荐）。程序按 USB 拓扑给端口分组，一台模块 = 一组，
#        组内发 PING，谁能回 +PONG 谁就是数据口。插几台认几台，热插拔也能自愈。
MODEM_PORT=auto
# 显式指定端口，逗号分隔。填了就只用这些口，不再自动发现。
# 例：/dev/ttyACM0,/dev/ttyACM3   或   COM7,COM10
MODEM_PORTS=
MODEM_BAUD=115200

# 通讯协议：
#   auto   = 启动时自动探测（推荐）
#   at     = 标准 AT 指令固件（GSM 07.05 短信命令）
#   luatos = 模块刷了 firmware/main.lua 桥接脚本（Air780EPM 官方唯一可行路线）
MODEM_PROTOCOL=auto

# ===== 模拟模式（不接硬件也能看界面）=====
MODEM_MOCK=0
# mock 模式下模拟几台设备，多设备联调用
MODEM_MOCK_COUNT=1

# ===== 短信 =====
# SM=SIM 卡（容量小但通用），ME=模块（容量大，部分固件不支持）
SMS_STORAGE=SM
# SIM 卡 PIN 码（4~8 位）。国内卡默认不开 PIN，留空即可。
# 如果卡设了 PIN：填在这里，网关会在 SIM 未就绪时自动解锁（固件需 1.1.1+）。
# 注意：PIN 连续错 3 次卡会被锁，只能用 PUK 解，填之前先核对清楚。
SIM_PIN=
# 1 = 保留模块/SIM 里的短信不删除；0 = 入库后删除（推荐，避免 SIM 卡满）
KEEP_ON_MODEM=0
# 轮询新短信的间隔（秒）
POLL_INTERVAL=20
# 刷新信号/注册状态的间隔（秒）
STATUS_INTERVAL=45
# 操作日志保留天数
LOG_RETENTION_DAYS=7

# ===== 服务 =====
WEB_PORT=8080

# 访问密码。留空 = 不登录（仅限完全可信的内网）。强烈建议设置
AUTH_PASSWORD=
# 会话签名密钥，留空则自动生成并存在数据库里
SECRET_KEY=

SITE_TITLE=短信网关
# 转发 payload 里带的设备名（多台时可写成位置，如 客厅）
DEVICE_NAME=air780epm
TZ=Asia/Shanghai

# ===== 构建参数（国内网络）=====
# 基础镜像，拉不动 python:3.12-slim 时可以换成镜像站地址
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim

# pip 源。默认阿里云；构建时会按 PIP_INDEX -> PIP_FALLBACK_INDEXES 顺序自动重试，
# 某一家不通不影响构建。可选值：
#   阿里云   https://mirrors.aliyun.com/pypi/simple
#   腾讯云   https://mirrors.cloud.tencent.com/pypi/simple
#   清华     https://pypi.tuna.tsinghua.edu.cn/simple
#   官方     https://pypi.org/simple
# PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
# PIP_FALLBACK_INDEXES=https://mirrors.cloud.tencent.com/pypi/simple https://pypi.org/simple
